const BaseProvider = require('./base');
const { getDoc, toAbsolute, getBaseUrl, cfPost } = require('../utils/scraper');

class ArabSeed extends BaseProvider {
  constructor() {
    super();
    this.name = 'ArabSeed';
    this.baseUrl = 'https://m.asd.ink'; 
    this.catalogId = 'arabseed';
  }

  async resolveBaseUrl() {
    const mirrors = [
      'https://m.asd.ink',
      'https://asdnet2.arabseed.net',
      'https://m1.arabseed.lol',
      'https://m7.arabseed.wiki',
    ];
    for (const mirror of mirrors) {
      try {
        const res = await require('axios').get(mirror, { timeout: 5000, maxRedirects: 2 });
        if (res.status === 200) {
          this.baseUrl = getBaseUrl(res.request?.res?.responseUrl || mirror);
          return this.baseUrl;
        }
      } catch {}
    }
    return this.baseUrl;
  }

  async getCatalog(type, page = 1) {
    await this.resolveBaseUrl();
    const path = type === 'movie' ? '/movies/' : '/main0/';
    const url = page > 1 ? `${this.baseUrl}${path}page/${page}/` : `${this.baseUrl}${path}`;

    const $ = await getDoc(url);
    const items = [];

    $('.movie__block').each((_, el) => {
      const title = $(el).find('h3').text().trim();
      const href = $(el).attr('href') || $(el).closest('a').attr('href');
      const poster = $(el).find('img').attr('data-src') || $(el).find('img').attr('src');
      if (!title || !href) return;

      items.push({
        id: `arabseed:${Buffer.from(toAbsolute(href, this.baseUrl)).toString('base64')}`,
        type,
        name: title,
        poster: toAbsolute(poster || '', this.baseUrl),
      });
    });

    return items;
  }

  async search(query) {
    await this.resolveBaseUrl();
    const url = `${this.baseUrl}/find/?word=${encodeURIComponent(query)}`;
    const $ = await getDoc(url);
    const items = [];

    $('ul.blocks__ul > li').each((_, el) => {
      const a = $(el).find('a.movie__block');
      const title = a.attr('title') || a.find('h3').text().trim();
      const href = a.attr('href');
      const poster = a.find('img').attr('data-src') || a.find('img').attr('src');
      if (!title || !href) return;

      const type = href.includes('%d9%81%d9%8a%d9%84%d9%85') ? 'movie' : 'series';
      items.push({
        id: `arabseed:${Buffer.from(toAbsolute(href, this.baseUrl)).toString('base64')}`,
        type,
        name: title,
        poster: toAbsolute(poster || '', this.baseUrl),
      });
    });

    return items;
  }

  async getStreams(encodedUrl) {
    await this.resolveBaseUrl();
    const pageUrl = Buffer.from(encodedUrl, 'base64').toString();
    const $ = await getDoc(pageUrl);

    const watchBtn = $('a.btton.watch__btn').attr('href');
    if (!watchBtn) return [];

    const watchUrl = toAbsolute(watchBtn, this.baseUrl);
    const $w = await getDoc(watchUrl);

    const csrfToken = $w('script').text().match(/'csrf__token':\s*"([^"]+)"/)?.[1];
    const postId = $w('.servers__list li').first().attr('data-post');
    if (!csrfToken || !postId) return [];

    const streams = [];
    const qualities = [];
    $w('.quality__swither ul.qualities__list li').each((_, el) => {
      qualities.push($w(el).attr('data-quality'));
    });

    for (const quality of qualities) {
      try {
        // تم استبدال طلب axios المباشر بـ cfPost المار عبر سيرفر التخطي لحمايته من البلوك
        const apiUrl = `${this.baseUrl}/get__quality__servers/`;
        const postData = new URLSearchParams({ post_id: postId, quality, csrf_token: csrfToken }).toString();
        
        const rawHtml = await cfPost(apiUrl, postData);
        const $s = require('cheerio').load(rawHtml || '');
        
        $s('li').each((_, el) => {
          const serverName = $s(el).text().trim() || 'Server';
          // ملاحظة: المواقع العربية تعرض الروابط غالباً داخل وسوم iframe أو خصائص بيانات 
          // تم تهيئتها كعنوان فرعي هنا لتجنب كراش التشغيل المباشر
          streams.push({
            name: `ArabSeed [${quality}]`,
            title: `${serverName} (${quality})`,
            url: watchUrl // هنا يمكنك تطوير كود الكشط لجلب الرابط الصافي الداخلي للسيرفر لاحقاً
          });
        });
      } catch {}
    }

    return streams;
  }
}

module.exports = ArabSeed;
